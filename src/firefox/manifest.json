{
  "manifest_version": 3,
  "name": "Aloud — Natural Read Aloud",
  "short_name": "Aloud",
  "version": "{{VERSION}}",
  "description": "Edge-style read aloud for Firefox: natural voices, word highlighting, click-to-jump, and clutter-free reading.",
  "browser_specific_settings": {
    "gecko": {
      "id": "aloud@fezexven.xyz",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Read aloud (Ctrl+Shift+U)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "scripts": [
      "shared.js",
      "timing.js",
      "player.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*.tts.speech.microsoft.com/*",
    "https://api.elevenlabs.io/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Start / stop reading"
    },
    "play-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Play / pause"
    },
    "next-paragraph": {
      "suggested_key": {
        "default": "Alt+Shift+Right"
      },
      "description": "Next paragraph"
    },
    "prev-paragraph": {
      "suggested_key": {
        "default": "Alt+Shift+Left"
      },
      "description": "Previous paragraph"
    }
  }
}
